# Web service
JUKU_PORT=8999
JUKU_BIND_ADDRESS=0.0.0.0
TZ=Asia/Shanghai

# Set a strong password before deployment.
JUKU_ADMIN_USER=admin
JUKU_ADMIN_PASSWORD=replace-with-a-long-random-password

# Public HTTP(S) origin reachable by Emby and ForwardWidget.
# Example: https://juku.example.com
JUKU_PUBLIC_URL=

# Leave paths empty to generate persistent high-entropy private paths in /data.
# Or use private values such as /fw-5c3d... and /emby-9a7f...
JUKU_FORWARD_PATH=
JUKU_EMBY_PATH=

# Leave empty to generate and persist a private ForwardWidget token in /data.
JUKU_FORWARD_TOKEN=

# Container path exported as an Emby television library.
JUKU_EMBY_EXPORT_DIR=/emby-library

# Optional upstream proxy.
JUKU_PROXY_URL=
